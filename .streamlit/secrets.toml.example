# Secrets example — copy to .streamlit/secrets.toml and replace the values.
# Generate [AUTH] values with:  python -m src.auth
# On Streamlit Community Cloud, paste the same blocks into Settings -> Secrets.

[AUTH]
APP_PASSWORD_HASH = "pbkdf2$REPLACE_WITH_GENERATED_HASH"
TOTP_SECRET = "REPLACE_WITH_GENERATED_BASE32"
APP_NAME = "AR Reconciliation"

# Own-transfer highlight: regex patterns matched on the remitter segment only.
# List your company name and short forms.
[MATCH]
own_patterns = ["YOUR COMPANY NAME", "YOUR SHORT NAME"]

# Mail fetch (the "Fetch from mailboxes" button on the advice tab).
[MAIL]
lookback_days = 7
mailboxes = [
  { email = "you@example.com", app_password = "CHANGE_ME" },
]

# NVIDIA NIM AI assist for advices the local parser cannot read (optional).
[NVIDIA]
api_key = "nvapi-CHANGE_ME"
